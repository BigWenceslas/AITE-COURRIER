            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_agent'), ref('aite_courrier_base.group_assistant')])]"/>
            <field name="sla_hours">4</field>
            <field name="is_initial" eval="True"/>
        </record>
        <record id="step_fact_2" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_facture"/>
            <field name="sequence">2</field>
            <field name="name">Contrôle administratif</field>
            <field name="description">Vérification administrative et conformité</field>
            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_assistant')])]"/>
            <field name="sla_hours">24</field>
        </record>
        <record id="step_fact_3" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_facture"/>
            <field name="sequence">3</field>
            <field name="name">Comptabilité</field>
            <field name="description">Traitement comptable / budgétaire</field>
            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_compta')])]"/>
            <field name="sla_hours">48</field>
        </record>
        <record id="step_fact_4" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_facture"/>
            <field name="sequence">4</field>
            <field name="name">Validation responsable</field>
