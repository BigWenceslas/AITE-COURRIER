<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Les 5 circuits de base, prêts à l'emploi dès l'installation.
        noupdate="1" : ces données sont du paramétrage de départ ; les
        modifications faites par l'administrateur ne sont PAS écrasées lors
        d'une mise à jour du module.
    -->
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- CIRCUIT 1 — Courrier entrant standard (type ENTR)            -->
        <!-- ============================================================ -->
        <record id="circuit_entrant_standard" model="aite.workflow.circuit">
            <field name="name">Courrier entrant standard</field>
            <field name="type_id" ref="aite_courrier_base.type_entr"/>
        </record>

        <record id="step_entr_1" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_entrant_standard"/>
            <field name="sequence">1</field>
            <field name="name">Réception</field>
            <field name="description">Enregistrement et numérisation</field>
            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_agent')])]"/>
            <field name="sla_hours">4</field>
            <field name="is_initial" eval="True"/>
        </record>
        <record id="step_entr_2" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_entrant_standard"/>
            <field name="sequence">2</field>
            <field name="name">Qualification</field>
            <field name="description">Catégorisation, priorité, confidentialité</field>
            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_agent'), ref('aite_courrier_base.group_assistant')])]"/>
            <field name="sla_hours">8</field>
        </record>
        <record id="step_entr_3" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_entrant_standard"/>
            <field name="sequence">3</field>
            <field name="name">Affectation</field>
            <field name="description">Attribution service/responsable</field>
            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_assistant'), ref('aite_courrier_base.group_manager')])]"/>
            <field name="sla_hours">4</field>
        </record>
        <record id="step_entr_4" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_entrant_standard"/>
            <field name="sequence">4</field>
            <field name="name">Traitement</field>
            <field name="description">Analyse par le service destinataire</field>
            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_manager')])]"/>
            <field name="sla_hours">48</field>
        </record>
        <record id="step_entr_5" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_entrant_standard"/>
            <field name="sequence">5</field>
            <field name="name">Archivage</field>
            <field name="description">Clôture, indexation, conservation</field>
            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_archive')])]"/>
            <field name="sla_hours">24</field>
            <field name="is_final" eval="True"/>
        </record>

        <record id="trans_entr_1_2" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_entrant_standard"/>
            <field name="step_from_id" ref="step_entr_1"/>
            <field name="step_to_id" ref="step_entr_2"/>
            <field name="label">Qualifier</field>
            <field name="direction">forward</field>
        </record>
        <record id="trans_entr_2_3" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_entrant_standard"/>
            <field name="step_from_id" ref="step_entr_2"/>
            <field name="step_to_id" ref="step_entr_3"/>
            <field name="label">Affecter</field>
            <field name="direction">forward</field>
        </record>
        <record id="trans_entr_2_1" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_entrant_standard"/>
            <field name="step_from_id" ref="step_entr_2"/>
            <field name="step_to_id" ref="step_entr_1"/>
            <field name="label">Retourner</field>
            <field name="direction">backward</field>
            <field name="comment_required" eval="True"/>
        </record>
        <record id="trans_entr_3_4" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_entrant_standard"/>
            <field name="step_from_id" ref="step_entr_3"/>
            <field name="step_to_id" ref="step_entr_4"/>
            <field name="label">Transmettre</field>
            <field name="direction">forward</field>
        </record>
        <record id="trans_entr_3_2" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_entrant_standard"/>
            <field name="step_from_id" ref="step_entr_3"/>
            <field name="step_to_id" ref="step_entr_2"/>
            <field name="label">Retourner</field>
            <field name="direction">backward</field>
            <field name="comment_required" eval="True"/>
        </record>
        <record id="trans_entr_4_5" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_entrant_standard"/>
            <field name="step_from_id" ref="step_entr_4"/>
            <field name="step_to_id" ref="step_entr_5"/>
            <field name="label">Archiver</field>
            <field name="direction">forward</field>
        </record>
        <record id="trans_entr_4_3" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_entrant_standard"/>
            <field name="step_from_id" ref="step_entr_4"/>
            <field name="step_to_id" ref="step_entr_3"/>
            <field name="label">Réaffecter</field>
            <field name="direction">backward</field>
            <field name="comment_required" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!-- CIRCUIT 2 — Courrier sortant (type SORT)                     -->
        <!-- ============================================================ -->
        <record id="circuit_sortant" model="aite.workflow.circuit">
            <field name="name">Courrier sortant</field>
            <field name="type_id" ref="aite_courrier_base.type_sort"/>
        </record>

        <record id="step_sort_1" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_sortant"/>
            <field name="sequence">1</field>
            <field name="name">Préparation</field>
            <field name="description">Rédaction et mise en forme</field>
            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_agent'), ref('aite_courrier_base.group_assistant')])]"/>
            <field name="sla_hours">24</field>
            <field name="is_initial" eval="True"/>
        </record>
        <record id="step_sort_2" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_sortant"/>
            <field name="sequence">2</field>
            <field name="name">Contrôle</field>
            <field name="description">Vérification administrative et conformité</field>
            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_assistant')])]"/>
            <field name="sla_hours">8</field>
        </record>
        <record id="step_sort_3" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_sortant"/>
