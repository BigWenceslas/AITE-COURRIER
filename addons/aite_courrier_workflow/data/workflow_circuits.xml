        <record id="step_fact_7" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_facture"/>
            <field name="sequence">7</field>
            <field name="name">Archivage</field>
            <field name="description">Conservation légale</field>
            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_archive')])]"/>
            <field name="sla_hours">24</field>
            <field name="is_final" eval="True"/>
        </record>

        <record id="trans_fact_1_2" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_facture"/>
            <field name="step_from_id" ref="step_fact_1"/>
            <field name="step_to_id" ref="step_fact_2"/>
            <field name="label">Transmettre</field>
            <field name="direction">forward</field>
        </record>
        <record id="trans_fact_2_3" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_facture"/>
            <field name="step_from_id" ref="step_fact_2"/>
            <field name="step_to_id" ref="step_fact_3"/>
            <field name="label">Valider</field>
            <field name="direction">forward</field>
        </record>
        <record id="trans_fact_2_1" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_facture"/>
            <field name="step_from_id" ref="step_fact_2"/>
            <field name="step_to_id" ref="step_fact_1"/>
            <field name="label">Retourner</field>
            <field name="direction">backward</field>
            <field name="comment_required" eval="True"/>
        </record>
        <record id="trans_fact_3_4" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_facture"/>
            <field name="step_from_id" ref="step_fact_3"/>
