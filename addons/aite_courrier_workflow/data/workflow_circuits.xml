            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_signer')])]"/>
            <field name="sla_hours">24</field>
        </record>
        <record id="step_sort_5" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_sortant"/>
            <field name="sequence">5</field>
            <field name="name">Émission</field>
            <field name="description">Envoi destinataire et archivage</field>
            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_agent'), ref('aite_courrier_base.group_archive')])]"/>
            <field name="sla_hours">4</field>
            <field name="is_final" eval="True"/>
        </record>

        <record id="trans_sort_1_2" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_sortant"/>
            <field name="step_from_id" ref="step_sort_1"/>
            <field name="step_to_id" ref="step_sort_2"/>
            <field name="label">Soumettre</field>
            <field name="direction">forward</field>
        </record>
        <record id="trans_sort_2_3" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_sortant"/>
            <field name="step_from_id" ref="step_sort_2"/>
            <field name="step_to_id" ref="step_sort_3"/>
            <field name="label">Valider</field>
            <field name="direction">forward</field>
        </record>
        <record id="trans_sort_2_1" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_sortant"/>
            <field name="step_from_id" ref="step_sort_2"/>
            <field name="step_to_id" ref="step_sort_1"/>
            <field name="label">Retourner</field>
            <field name="direction">backward</field>
            <field name="comment_required" eval="True"/>
        </record>
        <record id="trans_sort_3_4" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_sortant"/>
            <field name="step_from_id" ref="step_sort_3"/>
            <field name="step_to_id" ref="step_sort_4"/>
            <field name="label">Soumettre visa</field>
            <field name="direction">forward</field>
        </record>
        <record id="trans_sort_3_2" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_sortant"/>
            <field name="step_from_id" ref="step_sort_3"/>
            <field name="step_to_id" ref="step_sort_2"/>
            <field name="label">Retourner</field>
            <field name="direction">backward</field>
            <field name="comment_required" eval="True"/>
        </record>
        <record id="trans_sort_4_5" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_sortant"/>
            <field name="step_from_id" ref="step_sort_4"/>
            <field name="step_to_id" ref="step_sort_5"/>
            <field name="label">Signer &amp; émettre</field>
            <field name="direction">forward</field>
        </record>
        <record id="trans_sort_4_3" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_sortant"/>
            <field name="step_from_id" ref="step_sort_4"/>
            <field name="step_to_id" ref="step_sort_3"/>
            <field name="label">Retourner</field>
            <field name="direction">backward</field>
            <field name="comment_required" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!-- CIRCUIT 3 — Courrier interne (type INT)                      -->
        <!-- ============================================================ -->
        <record id="circuit_interne" model="aite.workflow.circuit">
            <field name="name">Courrier interne</field>
            <field name="type_id" ref="aite_courrier_base.type_int"/>
        </record>

        <record id="step_int_1" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_interne"/>
            <field name="sequence">1</field>
            <field name="name">Création</field>
            <field name="description">Rédaction note/instruction</field>
            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_agent'), ref('aite_courrier_base.group_assistant'), ref('aite_courrier_base.group_manager')])]"/>
            <field name="sla_hours">0</field>
            <field name="is_initial" eval="True"/>
        </record>
        <record id="step_int_2" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_interne"/>
            <field name="sequence">2</field>
            <field name="name">Diffusion</field>
            <field name="description">Transmission aux destinataires</field>
            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_manager')])]"/>
            <field name="sla_hours">4</field>
        </record>
        <record id="step_int_3" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_interne"/>
            <field name="sequence">3</field>
            <field name="name">Accusé réception</field>
            <field name="description">Confirmation de prise en compte</field>
            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_agent'), ref('aite_courrier_base.group_assistant'), ref('aite_courrier_base.group_manager')])]"/>
            <field name="sla_hours">24</field>
        </record>
        <record id="step_int_4" model="aite.workflow.step">
            <field name="circuit_id" ref="circuit_interne"/>
            <field name="sequence">4</field>
            <field name="name">Archivage</field>
            <field name="description">Conservation avec historique</field>
            <field name="role_ids" eval="[(6, 0, [ref('aite_courrier_base.group_archive')])]"/>
            <field name="sla_hours">24</field>
            <field name="is_final" eval="True"/>
        </record>

        <record id="trans_int_1_2" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_interne"/>
            <field name="step_from_id" ref="step_int_1"/>
            <field name="step_to_id" ref="step_int_2"/>
            <field name="label">Diffuser</field>
            <field name="direction">forward</field>
        </record>
        <record id="trans_int_2_3" model="aite.workflow.transition">
            <field name="circuit_id" ref="circuit_interne"/>
            <field name="step_from_id" ref="step_int_2"/>
            <field name="step_to_id" ref="step_int_3"/>
            <field name="label">Confirmer</field>
