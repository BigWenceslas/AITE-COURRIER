<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aite_ecm_dossier_type_form" model="ir.ui.view">
        <field name="name">aite.ecm.dossier.type.form</field>
        <field name="model">aite.ecm.dossier.type</field>
        <field name="arch" type="xml">
            <form string="Type de dossier">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_dossiers" type="object"
                                class="oe_stat_button" icon="fa-folder-open">
                            <field name="dossier_count" widget="statinfo" string="Dossiers"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom du type de dossier"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="folder_id"/>
                            <field name="active_circuit_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pièces attendues" name="pieces">
                            <field name="piece_template_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="document_type_id" options="{'no_create': True}"/>
                                    <field name="required"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Circuits" name="circuits">
                            <field name="circuit_ids" context="{'default_res_model': 'aite.ecm.dossier', 'default_dossier_type_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1"/>
                            <div class="alert alert-info mt-2" role="status">
                                Les métadonnées du dossier se définissent depuis une fiche
                                dossier de ce type (« Ajouter une propriété »).
                            </div>
                            <field name="metadata_definition" invisible="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aite_ecm_dossier_type_list" model="ir.ui.view">
        <field name="name">aite.ecm.dossier.type.list</field>
        <field name="model">aite.ecm.dossier.type</field>
        <field name="arch" type="xml">
            <list string="Types de dossiers">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="folder_id"/>
                <field name="active_circuit_id"/>
                <field name="dossier_count"/>
            </list>
        </field>
    </record>

    <record id="action_aite_ecm_dossier_type" model="ir.actions.act_window">
        <field name="name">Types de dossiers</field>
        <field name="res_model">aite.ecm.dossier.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Type de dossier sur la fiche circuit (visible pour l'objet Dossier) -->
    <record id="view_aite_workflow_circuit_form_dossier" model="ir.ui.view">
        <field name="name">aite.workflow.circuit.form.dossier</field>
        <field name="model">aite.workflow.circuit</field>
        <field name="inherit_id" ref="aite_ecm_workflow.view_aite_workflow_circuit_form_ecm"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type_id']" position="after">
                <field name="dossier_type_id" invisible="res_model != 'aite.ecm.dossier'"
                       required="res_model == 'aite.ecm.dossier'"/>
            </xpath>
        </field>
    </record>
</odoo>
