<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ Entrée du tableau de bord portail ============
         Sans `placeholder_count`, Odoo n'applique pas le masquage
         automatique des tuiles à compteur nul : un tiers qui vient d'être
         invité voit l'entrée et peut déposer sa première demande. Le
         compteur est rendu côté serveur, dans le texte. -->
    <template id="portal_my_home_courrier" inherit_id="portal.portal_my_home"
              customize_show="True" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Mes courriers</t>
                <t t-set="url" t-value="'/my/courriers'"/>
                <t t-set="text">
                    <t t-if="courrier_count">
                        <t t-out="courrier_count"/> demande(s) suivie(s) — déposez-en une nouvelle
                    </t>
                    <t t-else="">Déposez une demande et suivez son traitement</t>
                </t>
            </t>
        </xpath>
    </template>

    <!-- ============ Fil d'Ariane ============ -->
    <template id="portal_breadcrumbs_courrier"
              inherit_id="portal.portal_breadcrumbs" priority="40">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'courrier'"
                class="breadcrumb-item active">Courriers</li>
            <li t-if="page_name in ('courrier_detail', 'courrier_new')"
                class="breadcrumb-item">
                <a href="/my/courriers">Courriers</a>
            </li>
            <li t-if="page_name == 'courrier_detail' and courrier"
                class="breadcrumb-item active">
                <t t-out="courrier.reference or courrier.subject"/>
            </li>
            <li t-if="page_name == 'courrier_new'"
                class="breadcrumb-item active">Nouvelle demande</li>
        </xpath>
    </template>

    <!-- ============ Bandeau de marque ============
         Réservé au logo de l'entreprise : celui de `res.company`, donc
         paramétrable sans toucher au code (Paramètres › Sociétés). -->
    <template id="portal_courrier_brand" name="Bandeau portail">
        <t t-set="company" t-value="request.env.company"/>
        <div class="o_aite_brand">
            <img t-if="company.logo" class="o_aite_brand_logo"
                 t-attf-src="/web/image/res.company/#{company.id}/logo"
                 t-att-alt="company.name"/>
            <div t-if="company.logo" class="o_aite_brand_sep"/>
            <div class="o_aite_brand_text">
                <p class="o_aite_brand_name"><t t-out="company.name"/></p>
                <p class="o_aite_brand_tag">Espace de dépôt et de suivi de vos courriers</p>
            </div>
        </div>
    </template>

    <!-- ============ Liste « Mes courriers » ============ -->
    <template id="portal_my_courriers" name="Mes courriers">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="o_aite_portal">
                <t t-call="aite_courrier_portal.portal_courrier_brand"/>

                <div class="o_aite_pagehead">
                    <div>
                        <h3>Mes courriers</h3>
                        <p class="o_aite_pagehead_sub">Suivez l'avancement de vos demandes</p>
                    </div>
                    <a href="/my/courriers/new" class="btn btn-primary">
                        <i class="fa fa-plus me-1"/>Nouvelle demande
                    </a>
                </div>

                <t t-if="not courriers">
                    <div class="o_aite_card">
                        <div class="o_aite_card_body text-center py-5">
                            <i class="fa fa-inbox fa-2x text-muted mb-3 d-block"/>
                            <p class="mb-3">Vous n'avez encore déposé aucune demande.</p>
                            <a href="/my/courriers/new" class="btn btn-primary">
                                <i class="fa fa-plus me-1"/>Déposer ma première demande
                            </a>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="o_aite_card">
                        <div class="table-responsive">
                            <table class="table o_aite_table">
                                <thead>
                                    <tr>
                                        <th>Référence</th>
                                        <th>Objet</th>
                                        <th class="text-end">Date</th>
                                        <th class="text-end">Statut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="courriers" t-as="courrier">
                                        <td>
                                            <a class="o_aite_ref"
                                               t-attf-href="/my/courriers/#{courrier.id}">
                                                <t t-out="courrier.reference or 'En cours d\'enregistrement'"/>
                                            </a>
                                        </td>
                                        <td>
                                            <span class="o_aite_subject"
                                                  t-att-title="courrier.subject"
                                                  t-out="courrier.subject"/>
                                        </td>
                                        <td class="text-end text-muted">
                                            <span t-field="courrier.date_received"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-attf-class="o_aite_state o_aite_state_#{courrier.state}"
                                                  t-out="state_labels.get(courrier.state, courrier.state)"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="o_portal_pager d-flex justify-content-center mt-3">
                        <t t-call="portal.pager"/>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- ============ Détail : suivi d'avancement ============ -->
    <template id="portal_courrier_detail" name="Suivi du courrier">
        <t t-call="portal.portal_layout">
            <div class="o_aite_portal">
                <t t-call="aite_courrier_portal.portal_courrier_brand"/>

                <!-- La référence n'est attribuée qu'à l'enregistrement du
                     courrier par le service : on ne la promet donc au tiers
                     que lorsqu'elle existe réellement. -->
                <div t-if="submitted" class="alert alert-success" role="status">
                    <i class="fa fa-check me-1" title="Demande enregistrée"
                       role="img" aria-label="Demande enregistrée"/>
                    <t t-if="courrier.reference">Votre demande a bien été
                        enregistrée sous la référence
                        <strong t-out="courrier.reference"/>. Conservez-la pour
                        vos échanges.</t>
                    <t t-else="">Votre demande a bien été reçue. Sa référence
                        vous sera communiquée dès sa prise en charge ; vous la
                        retrouverez sur cette page.</t>
                </div>

                <!-- Pièces écartées au dépôt : dit explicitement ce qui n'est
                     pas passé, plutôt que de laisser croire à un envoi complet. -->
                <div t-if="rejected" class="alert alert-warning" role="alert">
                    <p class="mb-2">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        <strong>Certaines pièces n'ont pas pu être jointes.</strong>
                        Vous pouvez nous les transmettre en répondant à l'accusé de réception.
                    </p>
                    <ul class="mb-0">
                        <li t-foreach="rejected" t-as="item">
                            <strong t-out="item['name']"/> — <t t-out="item['reason']"/>
                        </li>
                    </ul>
                </div>

                <div class="o_aite_card">
                    <div class="o_aite_card_head">
                        <h4><t t-out="courrier.reference or 'Demande reçue'"/></h4>
                        <span t-attf-class="o_aite_state o_aite_state_#{courrier.state}"
                              t-out="state_labels.get(courrier.state, courrier.state)"/>
                    </div>
                    <div class="o_aite_card_body">
                        <div class="row mb-4">
                            <div class="col-12 col-md-8">
                                <div><strong>Objet :</strong>
                                    <t t-out="courrier.subject"/></div>
                                <div class="text-muted">
                                    <strong>Nature :</strong>
                                    <t t-out="courrier.type_id.name"/>
                                </div>
                            </div>
                            <div class="col-12 col-md-4 text-md-end">
                                <div><strong>Reçu le :</strong>
                                    <span t-field="courrier.date_received"/></div>
                            </div>
                        </div>

                        <!-- Parcours du circuit : étape courante en évidence. -->
                        <t t-if="steps">
                            <h5>Avancement</h5>
                            <ul class="o_aite_steps mb-4">
                                <t t-set="current_seen" t-value="False"/>
                                <t t-foreach="steps" t-as="step">
                                    <t t-set="is_now"
                                       t-value="step.id == courrier.current_step_id.id"/>
                                    <li t-attf-class="#{'o_aite_step_now' if is_now else ('o_aite_step_done' if not current_seen else '')}">
                                        <t t-out="step.name"/>
                                        <span t-if="is_now" class="o_aite_state o_aite_state_pr ms-2">
                                            Étape en cours
                                        </span>
                                    </li>
                                    <t t-if="is_now" t-set="current_seen" t-value="True"/>
                                </t>
                            </ul>
                        </t>
                        <t t-else="">
                            <div class="alert alert-secondary" role="status">
                                Votre demande a été reçue et sera prochainement
                                prise en charge par nos équipes.
                            </div>
                        </t>

                        <!-- Cachet de traitement. Les fonctions intervenues
                             sont nommées, les personnes jamais : c'est le
                             cloisonnement retenu en revue. -->
                        <t t-if="visas">
                            <h5>Cachet de traitement</h5>
                            <div class="o_aite_cachet mb-4">
                                <div class="o_aite_cachet_head">
                                    <i class="fa fa-certificate me-2"/>
                                    <span>Demande traitée</span>
                                    <span class="o_aite_cachet_date"
                                          t-out="processed_date"
                                          t-options="{'widget': 'date'}"/>
                                </div>
                                <table class="o_aite_cachet_body">
                                    <tr t-foreach="visas" t-as="visa">
                                        <td class="o_aite_cachet_step"
                                            t-out="visa['step']"/>
                                        <td class="o_aite_cachet_fn"
                                            t-out="visa['function']"/>
                                        <td class="o_aite_cachet_when"
                                            t-out="visa['date']"
                                            t-options="{'widget': 'date'}"/>
                                    </tr>
                                </table>
                            </div>
                        </t>

                        <!-- Pièces du dossier (jetons d'accès sécurisés). -->
                        <t t-if="documents">
                            <h5>Pièces du dossier</h5>
                            <ul class="o_aite_files">
                                <li t-foreach="documents" t-as="doc">
                                    <a t-att-href="doc['url']">
                                        <i class="fa fa-paperclip" title="Pièce jointe"
                                           role="img" aria-label="Pièce jointe"/>
                                        <t t-out="doc['filename'] or doc['name']"/>
                                    </a>
                                </li>
                            </ul>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ============ Dépôt d'une demande ============ -->
    <template id="portal_courrier_new" name="Nouvelle demande">
        <t t-call="portal.portal_layout">
            <div class="o_aite_portal">
                <t t-call="aite_courrier_portal.portal_courrier_brand"/>

                <div class="o_aite_pagehead">
                    <div>
                        <h3>Nouvelle demande</h3>
                        <p class="o_aite_pagehead_sub">Les champs marqués d'une étoile sont obligatoires</p>
                    </div>
                </div>

                <div class="o_aite_card">
                    <div class="o_aite_card_body">
                        <form action="/my/courriers/new" method="post"
                              enctype="multipart/form-data" class="o_aite_form">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <div class="mb-3">
                                <label class="form-label" for="subject">Objet
                                    <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="subject"
                                       name="subject" required="required"
                                       placeholder="En quelques mots, l'objet de votre demande"
                                       t-att-value="default.get('subject')"/>
                                <div t-if="errors.get('subject')"
                                     class="text-danger small">
                                    <t t-out="errors['subject']"/>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="type_id">Nature de la
                                    demande <span class="text-danger">*</span></label>
                                <select class="form-select" id="type_id" name="type_id"
                                        required="required">
                                    <option value="">— Choisir —</option>
                                    <t t-foreach="types" t-as="type">
                                        <option t-att-value="type.id"
                                                t-att-selected="'selected' if str(type.id) == (default.get('type_id') or '') else None">
                                            <t t-out="type.name"/>
                                        </option>
                                    </t>
                                </select>
                                <div t-if="errors.get('type_id')"
                                     class="text-danger small">
                                    <t t-out="errors['type_id']"/>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="description">Votre
                                    message</label>
                                <!-- Le contenu par défaut se place DANS la zone de
                                     saisie : porté par `t-out` sur la balise elle-même,
                                     le `textarea` disparaît de la page quand la valeur
                                     est vide — le tiers voyait l'intitulé sans le champ. -->
                                <textarea class="form-control" id="description"
                                          name="description" rows="6"
                                          placeholder="Décrivez votre demande…"
                                ><t t-out="default.get('description') or ''"/></textarea>
                            </div>
                            <div class="mb-4">
                                <label class="form-label" for="attachments">Pièces jointes</label>
                                <div class="o_aite_drop"
                                     t-att-data-allowed="','.join(allowed_extensions)"
                                     t-att-data-max-mb="max_file_mb">
                                    <i class="fa fa-cloud-upload o_aite_drop_icon"/>
                                    <p class="o_aite_drop_hint mb-0">
                                        Glissez vos fichiers ici, ou cliquez pour les choisir —
                                        <strong>plusieurs à la fois</strong>.
                                    </p>
                                    <input type="file" id="attachments"
                                           name="attachments" multiple="multiple"
                                           t-att-accept="'.' + ',.'.join(allowed_extensions)"/>
                                </div>
                                <ul class="o_aite_filelist"/>
                                <div class="form-text">
                                    Formats acceptés :
                                    <t t-out="', '.join(e.upper() for e in allowed_extensions)"/> —
                                    <t t-out="max_file_mb"/> Mo maximum par fichier.
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-paper-plane me-1"/>Envoyer la demande
                            </button>
                            <a href="/my/courriers" class="btn btn-light">Annuler</a>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
