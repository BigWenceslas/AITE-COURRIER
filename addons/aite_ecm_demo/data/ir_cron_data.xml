<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Génère le jeu de données par lots (≤ 40 s), se relance jusqu'à la
             fin, puis se désactive. Armée par le hook d'installation. -->
        <record id="ir_cron_seed" model="ir.cron">
            <field name="name">AITE ECM : génération du jeu de données de test</field>
            <field name="model_id" ref="aite_ecm_document.model_aite_ecm_document"/>
            <field name="state">code</field>
            <field name="code">model._aite_demo_seed_batch()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
