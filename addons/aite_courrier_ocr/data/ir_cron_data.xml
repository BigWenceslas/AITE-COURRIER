<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Indexation plein texte asynchrone (lot de 20 versions / passage). -->
        <record id="ir_cron_courrier_ocr" model="ir.cron">
            <field name="name">AITE Courrier : indexation plein texte (OCR)</field>
            <field name="model_id" ref="aite_courrier_ged.model_aite_courrier_document_version"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_ocr()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
