<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aite_ecm_share_form" model="ir.ui.view">
        <field name="name">aite.ecm.share.form</field>
        <field name="model">aite.ecm.share</field>
        <field name="arch" type="xml">
            <form string="Lien de partage">
                <header>
                    <button name="action_deactivate" string="Désactiver" type="object"
                            class="btn-danger" invisible="not active"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Désactivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="document_id" options="{'no_create': True}"/>
                            <field name="recipient"/>
                            <field name="url" widget="CopyClipboardChar" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="expiry_date"/>
                            <field name="max_downloads"/>
                            <field name="view_only"/>
                            <field name="watermark"/>
                            <field name="watermark_text" invisible="not watermark"/>
                        </group>
                    </group>
                    <group string="Suivi">
                        <field name="download_count"/>
                        <field name="last_access"/>
                        <field name="is_valid"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aite_ecm_share_list" model="ir.ui.view">
        <field name="name">aite.ecm.share.list</field>
        <field name="model">aite.ecm.share</field>
        <field name="arch" type="xml">
            <list string="Partages" decoration-muted="not is_valid">
                <field name="name"/>
                <field name="document_id"/>
                <field name="recipient"/>
                <field name="expiry_date"/>
                <field name="download_count"/>
                <field name="max_downloads"/>
                <field name="view_only"/>
                <field name="watermark"/>
                <field name="is_valid"/>
            </list>
        </field>
    </record>

    <record id="action_aite_ecm_share" model="ir.actions.act_window">
        <field name="name">Partages externes</field>
        <field name="res_model">aite.ecm.share</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_aite_ecm_share" name="Partages externes"
              parent="aite_ecm_document.menu_aite_ecm_documents"
              action="action_aite_ecm_share" sequence="50"/>

    <!-- Boutons sur le document -->
    <record id="view_aite_ecm_document_form_share" model="ir.ui.view">
        <field name="name">aite.ecm.document.form.share</field>
        <field name="model">aite.ecm.document</field>
        <field name="inherit_id" ref="aite_ecm_document.view_aite_ecm_document_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_create_share" string="Partager" type="object"
                        icon="fa-share-alt" invisible="version_count == 0 or not active"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_shares" type="object" class="oe_stat_button"
                        icon="fa-share-alt" invisible="share_count == 0">
                    <field name="share_count" widget="statinfo" string="Partages"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
