<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aite_ecm_document_form_records" model="ir.ui.view">
        <field name="name">aite.ecm.document.form.records</field>
        <field name="model">aite.ecm.document</field>
        <field name="inherit_id" ref="aite_ecm_document.view_aite_ecm_document_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']" position="before">
                <div class="alert alert-warning mb-3" role="status" invisible="not legal_hold_active">
                    <i class="fa fa-gavel me-1"/><b>Gel juridique actif</b> —
                    <field name="legal_hold_names" readonly="1" class="d-inline"/>.
                    Ce document ne peut être ni modifié, ni mis à la corbeille, ni détruit.
                </div>
                <div class="alert alert-danger mb-3" role="status"
                     invisible="retention_state != 'expired' or legal_hold_active">
                    <i class="fa fa-hourglass-end me-1"/>Durée de conservation échue
                    (<field name="retention_deadline" readonly="1" class="d-inline"/>) —
                    sort final : <field name="final_fate" readonly="1" class="d-inline"/>.
                </div>
                <field name="legal_hold_active" invisible="1"/>
                <field name="retention_state" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='description']" position="before">
                <page string="Conservation" name="records">
                    <group>
                        <group string="Politique appliquée">
                            <field name="retention_rule_id" readonly="1"/>
                            <field name="retention_rule_forced_id" options="{'no_create': True}"
                                   groups="aite_courrier_base.group_archive,aite_courrier_base.group_manager,aite_courrier_base.group_admin"/>
                            <field name="retention_start" readonly="1"/>
                            <field name="retention_deadline" readonly="1"/>
                            <field name="final_fate" readonly="1"/>
                            <field name="retention_state" widget="badge" readonly="1"
                                   decoration-danger="retention_state == 'expired'"
                                   decoration-success="retention_state == 'permanent'"
                                   decoration-info="retention_state == 'intermediate'"/>
                            <field name="retention_note" readonly="1"/>
                        </group>
                        <group string="Conservation physique et données">
                            <field name="box_id" options="{'no_create_edit': True}"/>
                            <field name="paper_original"/>
                            <field name="personal_data"/>
                            <field name="legal_hold_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <div class="mt-2"
                         groups="aite_courrier_base.group_archive,aite_courrier_base.group_manager,aite_courrier_base.group_admin">
                        <button name="action_retention_keep" type="object" class="btn-secondary me-2"
                                string="Conserver définitivement" icon="fa-shield"/>
                        <button name="action_retention_extend" type="object" class="btn-secondary me-2"
                                string="Prolonger d'un an" icon="fa-calendar-plus-o"/>
                    </div>
                    <field name="disposition_line_ids" readonly="1" invisible="not disposition_line_ids">
                        <list>
                            <field name="disposition_id"/>
                            <field name="retention_deadline"/>
                            <field name="destroyed"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_aite_ecm_document_list_records" model="ir.ui.view">
        <field name="name">aite.ecm.document.list.records</field>
        <field name="model">aite.ecm.document</field>
        <field name="inherit_id" ref="aite_ecm_document.view_aite_ecm_document_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="retention_state" widget="badge" optional="hide"
                       decoration-danger="retention_state == 'expired'"
                       decoration-success="retention_state == 'permanent'"/>
                <field name="retention_deadline" optional="hide"/>
                <field name="legal_hold_active" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_aite_ecm_document_search_records" model="ir.ui.view">
        <field name="name">aite.ecm.document.search.records</field>
        <field name="model">aite.ecm.document</field>
        <field name="inherit_id" ref="aite_ecm_document.view_aite_ecm_document_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_trashed']" position="after">
                <separator/>
                <filter name="filter_expired" string="Conservation échue"
                        domain="[('retention_state', '=', 'expired')]"/>
                <filter name="filter_permanent" string="Conservation définitive"
                        domain="[('retention_state', '=', 'permanent')]"/>
                <filter name="filter_hold" string="Sous gel juridique"
                        domain="[('legal_hold_active', '=', True)]"/>
                <filter name="filter_personal" string="Données personnelles"
                        domain="[('personal_data', '=', True)]"/>
                <filter name="filter_due_year" string="Échéance dans l'année"
                        domain="[('retention_deadline', '&lt;=', (context_today() + relativedelta(years=1)).strftime('%Y-%m-%d')), ('retention_deadline', '!=', False)]"/>
            </xpath>
            <xpath expr="//filter[@name='group_month']" position="after">
                <filter name="group_retention" string="Cycle de vie archivistique"
                        context="{'group_by': 'retention_state'}"/>
                <filter name="group_rule" string="Règle de conservation"
                        context="{'group_by': 'retention_rule_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_aite_ecm_document_expired" model="ir.actions.act_window">
        <field name="name">Documents échus</field>
        <field name="res_model">aite.ecm.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('retention_state', '=', 'expired')]</field>
        <field name="context">{'search_default_group_rule': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun document échu</p>
            <p>Les documents dont la durée de conservation est atteinte apparaissent ici :
               décidez de leur sort final ou constituez un bordereau d'élimination.</p>
        </field>
    </record>
</odoo>
