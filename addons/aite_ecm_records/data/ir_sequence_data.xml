<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_aite_ecm_disposition" model="ir.sequence">
            <field name="name">Bordereau d'élimination</field>
            <field name="code">aite.ecm.disposition</field>
            <field name="prefix">BORD-%(year)s-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_aite_ecm_box" model="ir.sequence">
            <field name="name">Boîte d'archives</field>
            <field name="code">aite.ecm.box</field>
            <field name="prefix">BTE-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
