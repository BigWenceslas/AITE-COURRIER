<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aite_ecm_document_form_nextcloud" model="ir.ui.view">
        <field name="name">aite.ecm.document.form.nextcloud</field>
        <field name="model">aite.ecm.document</field>
        <field name="inherit_id" ref="aite_ecm_document.view_aite_ecm_document_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_nc_open" string="Ouvrir dans Nextcloud" type="object"
                        icon="fa-cloud" invisible="not nc_file_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_nc_open" type="object" class="oe_stat_button"
                        icon="fa-cloud" invisible="not nc_file_id" string="Nextcloud"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Nextcloud" name="nextcloud" invisible="nc_sync_state == 'none' and not nc_path">
                    <group>
                        <group>
                            <field name="nc_sync_state" widget="badge"
                                   decoration-success="nc_sync_state == 'synced'"
                                   decoration-warning="nc_sync_state in ('todo', 'pull')"
                                   decoration-danger="nc_sync_state in ('conflict', 'error')"/>
                            <field name="nc_path"/>
                            <field name="nc_url" widget="url"/>
                            <field name="nc_sync_date"/>
                        </group>
                        <group>
                            <field name="nc_share_url" widget="url" invisible="not nc_share_url"/>
                            <field name="nc_error" invisible="not nc_error"/>
                            <field name="nc_file_id" invisible="1"/>
                        </group>
                    </group>
                    <div>
                        <button name="action_nc_push" string="Envoyer vers Nextcloud" type="object"
                                class="btn-secondary me-2" icon="fa-cloud-upload"
                                invisible="version_count == 0"/>
                        <button name="action_nc_pull" string="Importer depuis Nextcloud" type="object"
                                class="btn-secondary me-2" icon="fa-cloud-download"
                                invisible="not nc_path or state != 'draft'"/>
                        <button name="action_nc_share" string="Lien public Nextcloud" type="object"
                                class="btn-secondary me-2" icon="fa-link"
                                invisible="version_count == 0 or nc_share_url"/>
                        <button name="action_nc_unshare" string="Révoquer le lien public" type="object"
                                class="btn-secondary" icon="fa-unlink" invisible="not nc_share_url"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_aite_ecm_document_list_nextcloud" model="ir.ui.view">
        <field name="name">aite.ecm.document.list.nextcloud</field>
        <field name="model">aite.ecm.document</field>
        <field name="inherit_id" ref="aite_ecm_document.view_aite_ecm_document_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="nc_sync_state" widget="badge" optional="hide"
                       decoration-success="nc_sync_state == 'synced'"
                       decoration-warning="nc_sync_state in ('todo', 'pull')"
                       decoration-danger="nc_sync_state in ('conflict', 'error')"/>
            </xpath>
        </field>
    </record>

    <record id="view_aite_ecm_document_search_nextcloud" model="ir.ui.view">
        <field name="name">aite.ecm.document.search.nextcloud</field>
        <field name="model">aite.ecm.document</field>
        <field name="inherit_id" ref="aite_ecm_document.view_aite_ecm_document_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_trashed']" position="after">
                <separator/>
                <filter name="filter_nc_conflict" string="Conflits Nextcloud"
                        domain="[('nc_sync_state', 'in', ('conflict', 'error'))]"/>
                <filter name="filter_nc_pending" string="Nextcloud en attente"
                        domain="[('nc_sync_state', 'in', ('todo', 'pull'))]"/>
            </xpath>
        </field>
    </record>
</odoo>
