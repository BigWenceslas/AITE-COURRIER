<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate=1 : étiquettes de départ, paramétrables, non écrasées. -->
    <data noupdate="1">

        <record id="tag_urgent" model="aite.courrier.document.tag">
            <field name="name">Urgent</field>
            <field name="color">1</field>
        </record>
        <record id="tag_confidentiel" model="aite.courrier.document.tag">
            <field name="name">Confidentiel</field>
            <field name="color">2</field>
        </record>
        <record id="tag_a_signer" model="aite.courrier.document.tag">
            <field name="name">À signer</field>
            <field name="color">3</field>
        </record>
        <record id="tag_contrat" model="aite.courrier.document.tag">
            <field name="name">Contrat</field>
            <field name="color">4</field>
        </record>
        <record id="tag_facture" model="aite.courrier.document.tag">
            <field name="name">Facture</field>
            <field name="color">5</field>
        </record>
        <record id="tag_relance" model="aite.courrier.document.tag">
            <field name="name">Relance</field>
            <field name="color">6</field>
        </record>
        <record id="tag_a_archiver" model="aite.courrier.document.tag">
            <field name="name">À archiver</field>
            <field name="color">9</field>
        </record>

    </data>
</odoo>
