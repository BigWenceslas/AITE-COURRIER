<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ajoute le dossier GED par défaut (auto-classement) au type de courrier. -->
    <record id="view_aite_courrier_type_form_ged" model="ir.ui.view">
        <field name="name">aite.courrier.type.form.ged</field>
        <field name="model">aite.courrier.type</field>
        <field name="inherit_id" ref="aite_courrier_base.view_aite_courrier_type_form"/>
        <field name="arch" type="xml">
            <field name="category" position="after">
                <field name="default_folder_id"/>
            </field>
        </field>
    </record>

</odoo>
