<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Colonne « Signature requise » dans l'éditeur d'étapes du circuit. -->
    <record id="view_aite_workflow_circuit_form_sign" model="ir.ui.view">
        <field name="name">aite.workflow.circuit.form.sign</field>
        <field name="model">aite.workflow.circuit</field>
        <field name="inherit_id" ref="aite_courrier_workflow.view_aite_workflow_circuit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='step_ids']/list/field[@name='is_final']"
                   position="after">
                <field name="require_signature" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
