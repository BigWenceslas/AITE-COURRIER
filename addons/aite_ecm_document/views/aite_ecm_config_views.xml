<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Types de documents -->
    <record id="view_aite_ecm_document_type_form" model="ir.ui.view">
        <field name="name">aite.ecm.document.type.form</field>
        <field name="model">aite.ecm.document.type</field>
        <field name="arch" type="xml">
            <form string="Type de document">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom du type"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="default_folder_id"/>
                            <field name="default_confidentiality_id"/>
                            <field name="allowed_extensions" placeholder="pdf,docx (vide = liste standard)"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <div class="alert alert-info" role="status">
                        <strong>Modèle de métadonnées :</strong> les propriétés de ce type
                        (dates, montants, listes de choix, liens…) se définissent depuis
                        n'importe quelle fiche document de ce type, via
                        <em>« Ajouter une propriété »</em> dans le bloc Métadonnées
                        (réservé aux managers et administrateurs). Elles s'appliquent
                        aussitôt à tous les documents du type.
                    </div>
                    <field name="metadata_definition" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aite_ecm_document_type_list" model="ir.ui.view">
        <field name="name">aite.ecm.document.type.list</field>
        <field name="model">aite.ecm.document.type</field>
        <field name="arch" type="xml">
            <list string="Types de documents">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="default_folder_id"/>
                <field name="default_confidentiality_id"/>
                <field name="document_count"/>
            </list>
        </field>
    </record>

    <record id="action_aite_ecm_document_type" model="ir.actions.act_window">
        <field name="name">Types de documents</field>
        <field name="res_model">aite.ecm.document.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Étiquettes -->
    <record id="view_aite_ecm_tag_list" model="ir.ui.view">
        <field name="name">aite.ecm.tag.list</field>
        <field name="model">aite.ecm.tag</field>
        <field name="arch" type="xml">
            <list string="Étiquettes" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_aite_ecm_tag" model="ir.actions.act_window">
        <field name="name">Étiquettes</field>
        <field name="res_model">aite.ecm.tag</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Types de relations -->
    <record id="view_aite_ecm_link_type_list" model="ir.ui.view">
        <field name="name">aite.ecm.link.type.list</field>
        <field name="model">aite.ecm.link.type</field>
        <field name="arch" type="xml">
            <list string="Types de relations" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="inverse_name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_aite_ecm_link_type" model="ir.actions.act_window">
        <field name="name">Types de relations</field>
        <field name="res_model">aite.ecm.link.type</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
