<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Import du dossier de dépôt du scanner -->
        <record id="ir_cron_ecm_hotfolder" model="ir.cron">
            <field name="name">AITE ECM : import du dossier de dépôt (scanner)</field>
            <field name="model_id" ref="model_aite_ecm_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_hotfolder_import()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <!-- Scan vers e-mail -->
        <record id="mail_alias_ecm_scan" model="mail.alias">
            <field name="alias_name">ecm-scan</field>
            <field name="alias_model_id" ref="model_aite_ecm_document"/>
            <field name="alias_contact">everyone</field>
            <field name="alias_defaults">{}</field>
        </record>
    </data>
</odoo>
