<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Purge quotidienne de la corbeille après
             aite_ecm.trash_retention_days jours (30 par défaut). -->
        <record id="ir_cron_ecm_purge_trash" model="ir.cron">
            <field name="name">AITE ECM : purge de la corbeille</field>
            <field name="model_id" ref="model_aite_ecm_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_trash()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
