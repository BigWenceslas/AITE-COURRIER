<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Types de relations entre documents -->
        <record id="link_type_annex" model="aite.ecm.link.type">
            <field name="code">ANNEX</field>
            <field name="name">est une annexe de</field>
            <field name="inverse_name">a pour annexe</field>
            <field name="sequence">10</field>
        </record>
        <record id="link_type_replaces" model="aite.ecm.link.type">
            <field name="code">REPLACES</field>
            <field name="name">remplace</field>
            <field name="inverse_name">est remplacé par</field>
            <field name="sequence">20</field>
        </record>
        <record id="link_type_references" model="aite.ecm.link.type">
            <field name="code">REF</field>
            <field name="name">fait référence à</field>
            <field name="inverse_name">est référencé par</field>
            <field name="sequence">30</field>
        </record>
        <record id="link_type_translation" model="aite.ecm.link.type">
            <field name="code">TRANSL</field>
            <field name="name">est une traduction de</field>
            <field name="inverse_name">a pour traduction</field>
            <field name="sequence">40</field>
        </record>

        <!-- Plan de classement de départ (renommable par le client) -->
        <record id="folder_direction" model="aite.ecm.folder">
            <field name="name">Direction générale</field>
            <field name="sequence">10</field>
        </record>
        <record id="folder_rh" model="aite.ecm.folder">
            <field name="name">Ressources humaines</field>
            <field name="sequence">20</field>
        </record>
        <record id="folder_rh_dossiers" model="aite.ecm.folder">
            <field name="name">Dossiers du personnel</field>
            <field name="parent_id" ref="folder_rh"/>
            <field name="sequence">10</field>
        </record>
        <record id="folder_juridique" model="aite.ecm.folder">
            <field name="name">Juridique et contrats</field>
            <field name="sequence">30</field>
        </record>
        <record id="folder_finance" model="aite.ecm.folder">
            <field name="name">Finance et comptabilité</field>
            <field name="sequence">40</field>
        </record>
        <record id="folder_achats" model="aite.ecm.folder">
            <field name="name">Achats et fournisseurs</field>
            <field name="sequence">50</field>
        </record>
        <record id="folder_qualite" model="aite.ecm.folder">
            <field name="name">Qualité et procédures</field>
            <field name="sequence">60</field>
        </record>

        <!-- Types de documents et modèles de métadonnées -->
        <record id="type_contrat" model="aite.ecm.document.type">
            <field name="code">CONTRAT</field>
            <field name="name">Contrat</field>
            <field name="sequence">10</field>
            <field name="default_folder_id" ref="folder_juridique"/>
            <field name="default_confidentiality_id" ref="aite_courrier_base.confidentiality_confidential"/>
            <field name="metadata_definition" eval="[
                {'name': 'contrat_parties', 'string': 'Parties', 'type': 'char'},
                {'name': 'contrat_objet', 'string': 'Objet du contrat', 'type': 'char'},
                {'name': 'contrat_date_effet', 'string': 'Date d\'effet', 'type': 'date'},
                {'name': 'contrat_date_fin', 'string': 'Date de fin', 'type': 'date'},
                {'name': 'contrat_montant', 'string': 'Montant', 'type': 'float'},
                {'name': 'contrat_devise', 'string': 'Devise', 'type': 'selection',
                 'selection': [['XAF', 'FCFA'], ['EUR', 'Euro'], ['USD', 'Dollar US']]},
                {'name': 'contrat_reconduction', 'string': 'Tacite reconduction', 'type': 'boolean'},
            ]"/>
        </record>
        <record id="type_procedure" model="aite.ecm.document.type">
            <field name="code">PROC</field>
            <field name="name">Procédure / instruction</field>
            <field name="sequence">20</field>
            <field name="default_folder_id" ref="folder_qualite"/>
            <field name="metadata_definition" eval="[
                {'name': 'proc_domaine', 'string': 'Domaine', 'type': 'selection',
                 'selection': [['rh', 'RH'], ['finance', 'Finance'], ['achats', 'Achats'],
                               ['si', 'Systèmes d\'information'], ['qualite', 'Qualité']]},
                {'name': 'proc_date_application', 'string': 'Date d\'application', 'type': 'date'},
                {'name': 'proc_revue', 'string': 'Prochaine revue', 'type': 'date'},
                {'name': 'proc_proprietaire', 'string': 'Responsable du processus', 'type': 'char'},
            ]"/>
        </record>
        <record id="type_facture_fournisseur" model="aite.ecm.document.type">
            <field name="code">FACT</field>
            <field name="name">Facture fournisseur</field>
            <field name="sequence">30</field>
            <field name="default_folder_id" ref="folder_finance"/>
            <field name="metadata_definition" eval="[
                {'name': 'fact_numero', 'string': 'N° de facture', 'type': 'char'},
                {'name': 'fact_fournisseur', 'string': 'Fournisseur', 'type': 'char'},
                {'name': 'fact_montant_ttc', 'string': 'Montant TTC', 'type': 'float'},
                {'name': 'fact_date', 'string': 'Date de facture', 'type': 'date'},
                {'name': 'fact_echeance', 'string': 'Échéance', 'type': 'date'},
            ]"/>
        </record>
        <record id="type_piece_rh" model="aite.ecm.document.type">
            <field name="code">RH</field>
            <field name="name">Pièce du dossier du personnel</field>
            <field name="sequence">40</field>
            <field name="default_folder_id" ref="folder_rh_dossiers"/>
            <field name="default_confidentiality_id" ref="aite_courrier_base.confidentiality_confidential"/>
            <field name="metadata_definition" eval="[
                {'name': 'rh_nature', 'string': 'Nature', 'type': 'selection',
                 'selection': [['cni', 'Pièce d\'identité'], ['diplome', 'Diplôme'],
                               ['contrat', 'Contrat de travail'], ['medical', 'Certificat médical'],
                               ['autre', 'Autre']]},
                {'name': 'rh_validite', 'string': 'Valide jusqu\'au', 'type': 'date'},
            ]"/>
        </record>
        <record id="type_pv" model="aite.ecm.document.type">
            <field name="code">PV</field>
            <field name="name">Procès-verbal / compte rendu</field>
            <field name="sequence">50</field>
            <field name="default_folder_id" ref="folder_direction"/>
            <field name="metadata_definition" eval="[
                {'name': 'pv_instance', 'string': 'Instance', 'type': 'char'},
                {'name': 'pv_date_seance', 'string': 'Date de séance', 'type': 'date'},
            ]"/>
        </record>
        <record id="type_generique" model="aite.ecm.document.type">
            <field name="code">DOC</field>
            <field name="name">Document générique</field>
            <field name="sequence">90</field>
        </record>

    </data>
</odoo>
