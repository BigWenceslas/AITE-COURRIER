<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_verify" model="ir.cron">
            <field name="name">AITE ECM : vérification d'intégrité (journal de preuve)</field>
            <field name="model_id" ref="model_aite_ecm_seal"/>
            <field name="state">code</field>
            <field name="code">model._cron_verify()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_pdfa" model="ir.cron">
            <field name="name">AITE ECM : copies de préservation PDF/A</field>
            <field name="model_id" ref="aite_ecm_document.model_aite_ecm_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_pdfa()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
