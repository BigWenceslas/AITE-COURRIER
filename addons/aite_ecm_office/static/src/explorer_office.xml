<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aite_ecm_document.Explorer" t-inherit="aite_ecm_document.Explorer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_ecm_ext_actions')]" position="inside">
            <button class="btn btn-sm btn-secondary" t-if="rec.office_app and !rec.is_locked and rec.active"
                    t-on-click="() => this.openOffice(rec)">
                <i class="fa fa-windows me-1"/>Ouvrir dans <t t-esc="rec.office_label"/>
            </button>
            <button class="btn btn-sm btn-secondary" t-if="rec.libreoffice and !rec.is_locked and rec.active"
                    t-on-click="() => this.openOffice(rec, true)">
                <i class="fa fa-file-text-o me-1"/>LibreOffice
            </button>
            <button class="btn btn-sm btn-secondary" t-if="state.meta.google_configured and rec.office_app and !rec.is_locked and rec.active and !rec.gdrive_file_id"
                    t-on-click="() => this.openGoogle(rec)">
                <i class="fa fa-google me-1"/>Google Docs
            </button>
            <button class="btn btn-sm btn-secondary" t-if="rec.gdrive_file_id" t-on-click="() => this.googlePull(rec)">
                <i class="fa fa-refresh me-1"/>Récupérer depuis Google
            </button>
            <button class="btn btn-sm btn-warning" t-if="rec.gdrive_file_id" t-on-click="() => this.googleFinish(rec)">
                <i class="fa fa-check me-1"/>Terminer l'édition Google
            </button>
        </xpath>
    </t>
</templates>
