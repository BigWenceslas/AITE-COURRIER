<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_google_sync" model="ir.cron">
            <field name="name">AITE ECM : rapatriement des documents édités dans Google</field>
            <field name="model_id" ref="aite_ecm_document.model_aite_ecm_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_google_sync()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_wopi_purge" model="ir.cron">
            <field name="name">AITE ECM : purge des jetons d'édition en ligne expirés</field>
            <field name="model_id" ref="model_aite_ecm_office_token"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
