<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- sign_oca donne la lecture de sign.oca.request à base.group_user sans
         règle : tout utilisateur interne lirait toutes les demandes (PDF
         compris). On la limite aux demandes où il est demandeur, abonné ou
         signataire — par son propre contact, pas par la société partenaire
         à laquelle ce contact peut être rattaché. Les règles de groupe
         s'additionnent (OU) : les utilisateurs et gestionnaires Signature
         gardent les accès que leur donne sign_oca. -->
    <record id="sign_oca_request_rule_internal_own" model="ir.rule">
        <field name="name">Sign Request internal users: own requests (AITE)</field>
        <field name="model_id" ref="sign_oca.model_sign_oca_request"/>
        <field name="domain_force">['|', '|',
            ('user_id', '=', user.id),
            ('message_partner_ids', 'in', [user.partner_id.id]),
            ('signer_ids.partner_id', 'in', [user.partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Même défaut côté signataires, plus grave : la ligne signataire porte
         le jeton du lien de signature. Rattachés à une même société
         partenaire, des collègues liraient le jeton les uns des autres et
         pourraient signer à leur place. On restreint la règle de sign_oca au
         contact de l'utilisateur (critère de la liste « Mes signatures » du
         portail). Réappliqué à chaque mise à jour de ce module, qui suit
         toujours celle de sign_oca. -->
    <record id="sign_oca.sign_oca_request_signer_rule_base_user_read" model="ir.rule">
        <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.id])]</field>
    </record>
</odoo>
