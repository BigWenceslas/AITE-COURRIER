<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aite_courrier_form_sign_oca" model="ir.ui.view">
        <field name="name">aite.courrier.form.sign.oca</field>
        <field name="model">aite.courrier</field>
        <field name="inherit_id" ref="aite_courrier_core.view_aite_courrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="current_step_require_signature" invisible="1"/>
                <field name="has_completed_signature" invisible="1"/>
                <button name="action_request_signature"
                        string="Demander la signature" type="object"
                        class="btn-warning" icon="fa-pencil"
                        invisible="state in ('draft', 'ar', 'rj') or not can_act or not current_step_require_signature or has_completed_signature"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sign_requests" type="object"
                        class="oe_stat_button" icon="fa-pencil-square-o"
                        invisible="sign_request_count == 0">
                    <field name="sign_request_count" widget="statinfo" string="Signatures"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
