<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Relances SLA + escalade hiérarchique (une seule fois par cycle
             d'étape, drapeaux réarmés au changement d'étape). Le délai
             d'escalade est paramétrable via le paramètre système
             aite_courrier.sla_escalation_hours (24 h par défaut). -->
        <record id="ir_cron_courrier_sla" model="ir.cron">
            <field name="name">AITE Courrier : relances et escalades SLA</field>
            <field name="model_id" ref="aite_courrier_core.model_aite_courrier"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_sla_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
